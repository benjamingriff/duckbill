# Create a confidential OAuth client at https://developers.monzo.com/
# and set its redirect URL to MONZO_REDIRECT_URI below.
MONZO_CLIENT_ID=oauth2client_...
MONZO_CLIENT_SECRET=mnzconf....
MONZO_REDIRECT_URI=http://localhost:8765/callback

# Where raw files, tokens and the DuckDB warehouse live. Relative to the repo root.
# Point it at ./data-demo to work with the synthetic dataset instead.
DUCKBILL_DATA_DIR=./data

# Optional: keep raw files and sync state in S3, and the Monzo token in SSM.
# See "Storage" in the README. Only one place may ever hold the token.
# DUCKBILL_STORAGE_URI=s3://your-bucket/duckbill
# DUCKBILL_TOKEN_PARAMETER=/duckbill/monzo-token
